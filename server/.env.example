# =============================================================================
# Future Quest 2026 - Server Environment Configuration Template
# Copy this file to .env and provide your actual secrets.
# NEVER commit the real .env file or credentials to source control.
# =============================================================================

PORT=3001
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Target Database Name
DB_NAME=future_quest_2026

# 64-character hex secret for signing session tokens and vault verification HMACs
HMAC_SECRET=replace_with_64_char_cryptographic_hex_secret

# Administrative token for dev-reset and contest management operations
ADMIN_TOKEN=replace_with_secure_admin_token

# Allowed CORS client origin(s) (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,https://future-quest-ten.vercel.app

